# Local development only. Copy to .env to customize; never commit actual credentials.
POSTGRES_PASSWORD=firmware-local-only
CONTROLLER_PORT=8000
WORKER_METRICS_PORT=9001
SIMULATOR_PORT=8001
DEVICE_COUNT=1000
# The supplied simulator reads SEED, not the prototype's SIMULATOR_SEED.
SEED=42
OLD_VERSION=1.0.0
PERIODIC_INFORM_SEC=300
DOWNLOAD_MIN_SEC=2
DOWNLOAD_MAX_SEC=20
REBOOT_MIN_SEC=5
REBOOT_MAX_SEC=240
P_DUPLICATE=0.05
P_LATE=0.05
LATE_EXTRA_SEC=600
P_OFFLINE=0.05
P_REJECT=0.03
P_FAULT=0.04
P_NO_TC=0.03
P_REVERT=0.02

# Optional callback adapter only; forwarded by compose.simulator-fix.yaml.
# Separate HTTP admission limits keep periodic traffic out of the critical pool.
SIM_CALLBACK_PERIODIC_CONCURRENCY=16
SIM_CALLBACK_CRITICAL_CONCURRENCY=32
# Total delivery attempts, including the first; retries repeat the same callback.
SIM_CALLBACK_MAX_ATTEMPTS=3
# Seconds. The network-attempt timeout does not include admission queue wait.
SIM_CALLBACK_REQUEST_TIMEOUT=5
SIM_CALLBACK_RETRY_BASE_DELAY=0.2
SIM_CALLBACK_MAX_RETRY_DELAY=2

# To use an external evaluator's simulator, set a URL reachable from the containers.
# The external simulator must call the controller through its externally reachable URL.
SIMULATOR_URL=http://simulator:8001

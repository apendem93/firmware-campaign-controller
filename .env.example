# Local development only. Copy to .env to customize; never commit actual credentials.
POSTGRES_PASSWORD=firmware-local-only
CONTROLLER_PORT=8000
WORKER_METRICS_PORT=9001
SIMULATOR_PORT=8001
DEVICE_COUNT=1000
SIMULATOR_SEED=42
SIMULATOR_TIME_SCALE=1

# To use an external evaluator's simulator, set a URL reachable from the containers.
# The external simulator must call the controller through its externally reachable URL.
SIMULATOR_URL=http://simulator:8001
